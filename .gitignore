# Create new .gitignore file
@"
# Virtual Environment
ML-loan-default-prediction/
venv/
env/
ENV/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
develop-eggs/
eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints/
notebook.ipynb  # Remove from git if too large

# Project specific
*.log
*.db
models/__pycache__/

# Model files (keep only essential ones if needed)
# models/*.pkl
# !models/best_tuned_model.pkl
# !models/scaler.pkl
# !models/label_encoders.pkl
# !models/selected_features.pkl

# Large data files
data/*.csv
data/*.xlsx
!data/.gitkeep

# Images (optional - can be excluded if too large)
# images/
"@ | Out-File -FilePath ".gitignore" -Encoding UTF8